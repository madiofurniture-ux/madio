{
  "rewrites": [
    {
      "source": "/((?!api/)(?!@vite/)(?!@react-refresh)(?!node_modules/)(?!src/)(?!.*\\..*).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
